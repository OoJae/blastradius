# BlastRadius local development environment.
# Copy to .env and adjust if you changed docker-compose.yml.
# No secrets live in this repo: the token below is the documented HydraDB
# local-development token and is only valid against your own local node.

# HydraDB auth token. Must be at least 32 characters (HydraDB rejects shorter
# tokens and the literal "change-me"). `just up` writes this into
# hydradb-data/auth-token.
HYDRA_TOKEN=local-development-token-32-bytes

# Bolt endpoint (Neo4j-compatible driver, Bolt 5.1-5.4).
# Auth is the basic scheme with username "neo4j" and the token as password.
HYDRA_BOLT_URI=neo4j://127.0.0.1:7687

# HTTP JSON query API.
HYDRA_HTTP_URL=http://127.0.0.1:8443

# Admin port: GET /readyz and GET /metrics.
HYDRA_ADMIN_URL=http://127.0.0.1:9090

# Graph addressing. These must match the GRAPH_* environment variables in
# docker-compose.yml; X-Graph-Namespace on HTTP requests must equal HYDRA_NAMESPACE.
HYDRA_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0
HYDRA_DATABASE=default

# GCP project that BigQuery extraction bills to (Phase 1, deps.dev dataset).
# Always passed explicitly. Never rely on the active gcloud configuration:
# the machine's default config may point at an unrelated project, and a
# forgotten flag would bill someone else's work.
GCP_PROJECT=blastradius-2026

