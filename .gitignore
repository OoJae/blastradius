# Private planning documents (not part of the public submission)
_private/

# HydraDB source, cloned for reference only (AGPL-3.0 — never vendored into this repo)
vendor-readonly/

# Local HydraDB state: object store, cache, auth token
hydradb-data/

# Downloaded/derived data (fixtures under data/fixtures/ are checked in)
data/cache/
data/raw/
# Exclude the *contents*, not the directory: git cannot re-include anything
# under an excluded directory, so `data/slice/` followed by a negation silently
# does nothing.
data/slice/*
# ...except the compiled demo slice. It is 9.1 MB of gzipped CSV and it is the
# deployable artifact: the image ships it and builds the graph on first boot,
# rather than moving the 1.7 GB object store it becomes. Committing it also
# makes the deployment reproducible by anyone with the repo.
!data/slice/demo-20260810/
!data/slice/demo-20260810/**
# The hosted slice is smaller, to fit the 5 GB object-store volume the hosting
# plan allows; BLASTRADIUS_SLICE picks which one a deployment builds.
!data/slice/hosted-20260810/
!data/slice/hosted-20260810/**

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / web
node_modules/
dist/
.vite/

# Environment
.env
.env.local

# OS / editor
.DS_Store
*.swp
